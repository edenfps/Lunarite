# systemd unit for the Lunarite server on Linux (installed by deploy/linux/setup.sh).
# Restart=always replaces Watch-HuxleyServer.ps1 and also starts the server after a reboot.
# Settings live in /etc/huxley/huxley.env (see huxley.env.example).
[Unit]
Description=Lunarite server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huxley
Group=huxley
WorkingDirectory=/opt/huxley/repo
EnvironmentFile=/etc/huxley/huxley.env
# Wine keeps its prefix (the battlefield instances' C: drive and registry) here.
Environment=WINEPREFIX=/opt/huxley/wine
Environment=WINEDEBUG=-all
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/usr/bin/dotnet /opt/huxley/repo/Lunarite.Server/bin/Release/net9.0/Lunarite.Server.dll
Restart=always
RestartSec=5
# Five crashes inside ten minutes stop the restarts (see `journalctl -u huxley`).
StartLimitIntervalSec=600
StartLimitBurst=5
# The free cash-shop/archive web server listens on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Battlefield instances are child processes; stopping the service stops them too.
KillMode=control-group
TimeoutStopSec=20
StandardOutput=append:/var/log/huxley/server.log
StandardError=append:/var/log/huxley/server.err.log

[Install]
WantedBy=multi-user.target
