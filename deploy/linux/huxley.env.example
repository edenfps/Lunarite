# Copy to /etc/huxley/huxley.env and fill in. Read by huxley.service. These are the settings a Linux
# host needs; huxley.conf.example in the repository root lists every setting with its default, in
# the same KEY=VALUE format (any of them can go in this file).

# The address players reach this machine at (the VPS public IP; a LAN IP for a local VM test).
HUXLEY_GAME_PUBLIC_IP=203.0.113.10

# Game client install (battlefields run its exe under Wine) and the patch payload players download.
# No spaces in these paths: UE3 splits command-line paths at spaces.
HUXLEY_CLIENT_ROOT=/opt/huxley/client
HUXLEY_PATCH_ROOT=/opt/huxley/payload
# Clean client served under the payload so the launcher installs the whole game into an empty
# folder (about 22 GB per new player). Use an untouched copy, not the client above: battlefield
# instances write their own INIs into it, and those would go out to players.
HUXLEY_PATCH_BASE=/opt/huxley/clean-client

# Wine launcher for battlefield instances. They need a display (Direct3D), so a virtual one (Xvfb).
HUXLEY_WINE=xvfb-run -a wine
# Seconds a battlefield instance gets to start (default 120 on Linux: the first one after a boot
# takes about 95 s under Wine, later ones about 12 s).
# HUXLEY_BATTLE_START_SECONDS=120

HUXLEY_BACKUP_DIR=/opt/huxley/backups
HUXLEY_BACKUP_RETENTION=168
HUXLEY_GM_LOGINS=admin
QUEST_GATEWAY_DISABLED=1
